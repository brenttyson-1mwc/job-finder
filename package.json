{
  "name": "jobfinder",
  "version": "2026.06.15.1",
  "description": "Automated job search and enrichment pipeline. Searches job boards, evaluates listings with an LLM, and stores qualified jobs in Notion.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mauricedesaxe/job-finder.git"
  },
  "keywords": [
    "job-search",
    "scraping",
    "notion",
    "llm",
    "automation",
    "openrouter"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "scrape": "npx tsx src/index.ts",
    "reconcile": "npx tsx src/index.ts --reconcile-only",
    "test": "node --test",
    "test:integration": "node --test src/**/__integration__/",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@evilmartians/lefthook": "2.1.4",
    "@types/node": "^20.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.7.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@notionhq/client": "2.3.0",
    "dotenv": "^17.4.2",
    "openai": "6.33.0",
    "pino": "^10.3.1",
    "zod": "4.3.6"
  }
}
